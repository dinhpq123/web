# ── HADIWA IOC — Simulator Tools Environment ─────────────────────────────────
# Copy file này thành .env và chỉnh sửa theo môi trường thực tế

# ── HTTP Hydro Simulator (Trạm thủy văn REST API) ────────────────────────────
HYDRO_HTTP_PORT=7100

# ── MQTT Flood Publisher (Cảnh báo lũ & IoT) ─────────────────────────────────
FLOOD_MQTT_PORT=1884
FLOOD_MQTT_WS_PORT=9002
FLOOD_MQTT_PUBLISH_INTERVAL_MS=10000

# ── Reservoir Gate SCADA (Hồ chứa REST API) ──────────────────────────────────
RESERVOIR_SCADA_PORT=7101

# ── Rainfall Datalogger (Chuỗi thời gian mưa) ────────────────────────────────
RAINFALL_DATALOGGER_PORT=7102

# ── Pump Station Simulator (12 trạm bơm) ─────────────────────────────────────
PUMP_SIM_PORT=7103

# ── IoT Flood Sensor Simulator (20 cảm biến ngập) ────────────────────────────
FLOOD_SENSOR_PORT=7104

# ── Sluice Gate SCADA (18 cống điều tiết) ────────────────────────────────────
SLUICE_SIM_PORT=7105

# ── Weather Simulator (5 trạm khí tượng + dự báo) ────────────────────────────
WEATHER_SIM_PORT=7106

# ── Landslide Sensor Simulator (10 cảm biến sạt lở) ─────────────────────────
LANDSLIDE_SIM_PORT=7107

# ── Admin Server + Dashboard UI ───────────────────────────────────────────────
ADMIN_PORT=7200

# ── SCADA Update Interval ─────────────────────────────────────────────────────
SCADA_INTERVAL_MS=5000

# ── Kịch bản mặc định: normal | rain_watch | flood | storm | typhoon | drought ─
DEFAULT_SCENARIO=normal
